          },
          "client_digest": {
            "description": "sha256 hex; idempotency key",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Client Digest",
            "type": "string"
          },
          "enc_scheme": {
            "default": "aes-256-gcm/v1",
            "enum": [
              "aes-256-gcm/v1",
              "none"
            ],
