      "TurnRecord": {
        "description": "One recorded turn.",
        "properties": {
          "agent_did": {
            "title": "Agent Did",
            "type": "string"
          },
          "channel_id": {
            "anyOf": [
              {
                "maxLength": 66,
                "type": "string"
              },
              {
                "type": "null"
