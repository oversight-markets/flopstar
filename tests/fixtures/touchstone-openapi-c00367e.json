                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Token Ids"
          },
          "receipt": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
