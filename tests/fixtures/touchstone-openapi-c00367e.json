            "title": "Receipt"
          },
          "recorded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded At"
          },
          "request_enc": {
            "contentMediaType": "application/octet-stream",
            "format": "base64",
            "title": "Request Enc",
            "type": "string"
          },
          "request_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Sha256"
          },
          "response_enc": {
            "contentMediaType": "application/octet-stream",
            "format": "base64",
            "title": "Response Enc",
            "type": "string"
          },
          "response_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Sha256"
          },
          "route": {
            "default": "direct",
            "enum": [
              "direct",
              "gateway",
              "other"
            ],
